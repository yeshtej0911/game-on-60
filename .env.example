# Start in DEMO_MODE to test the whole local workflow without paid API usage.
DEMO_MODE=true
TIMEZONE=Asia/Kolkata
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./gameon.db
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=content.events
OUTPUT_DIR=output
ASSET_DIR=assets/approved
SHORTS_PER_DAY=5
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
ENABLE_TTS=false
